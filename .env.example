# PostgreSQL connection for the platform
DATABASE_URL=postgres://providentra:providentra@localhost:5432/providentra

# Redis for BullMQ job queue
REDIS_URL=redis://localhost:6379

# Directory where cloned repos and compose files are stored
RUNTIME_DIR=./runtime

# Directory for per-project Caddy reverse-proxy snippets
CADDY_CONFIG_DIR=./runtime/caddy

# Base Caddyfile the worker reads and forwards to the executor to reload Caddy
CADDYFILE_PATH=./Caddyfile

# HTTP API for container lifecycle (Docker Engine API via executor service)
DOCKER_EXECUTOR_URL=http://127.0.0.1:3100

# Executor service settings (used by `pnpm executor`)
EXECUTOR_PORT=3100
DOCKER_SOCKET=/var/run/docker.sock
# Caddy admin API, reachable by the executor over the internal Docker network.
# Not published to the host; only the executor talks to it.
CADDY_ADMIN_URL=http://caddy:2019
# Host path for bind mounts when executor runs inside Docker
# RUNTIME_HOST_DIR=/absolute/path/to/providentra/runtime

# Nuxt dev server port (control panel)
NUXT_PORT=3000

# Better Auth (control panel)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
